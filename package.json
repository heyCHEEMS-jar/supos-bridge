{
  "name": "supos-bridge",
  "description": "%extension.description%",
  "displayName": "SupOS Bridge",
  "version": "0.0.4",
  "author": "heyCHEEMS",
  "publisher": "heyCHEEMS",
  "license": "ISC",
  "keywords": [
    "supos",
    "supos-bridge",
    "可编程组件",
    "snippets"
  ],
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Snippets",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "supos-bridge.generateTypes",
        "title": "%command.generateTypes.title%",
        "category": "SupOS Bridge"
      },
      {
        "command": "supos-bridge.restart",
        "title": "%command.restart.title%",
        "category": "SupOS Bridge"
      },
      {
        "command": "supos-bridge.login",
        "title": "%command.login.title%",
        "category": "SupOS Bridge"
      },
      {
        "command": "supos-bridge.selectApp",
        "title": "%command.selectApp.title%",
        "category": "SupOS Bridge"
      },
      {
        "command": "supos-bridge.selectComponent",
        "title": "%command.selectComponent.title%",
        "category": "SupOS Bridge"
      },
      {
        "command": "supos-bridge.pullComponent",
        "title": "%command.pullComponent.title%",
        "category": "SupOS Bridge"
      },
      {
        "command": "supos-bridge.pushComponent",
        "title": "%command.pushComponent.title%",
        "category": "SupOS Bridge"
      }
    ],
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/supos.jsonc"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/supos.jsonc"
      },
      {
        "language": "typescript",
        "path": "./snippets/supos.jsonc"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/supos.jsonc"
      }
    ],
    "configuration": {
      "title": "SupOS Bridge",
      "properties": {
        "baseURL": {
          "type": "string",
          "default": "",
          "description": "%config.baseURL.description%"
        },
        "loginPagePath": {
          "type": "string",
          "default": "/login",
          "description": "%config.loginPagePath.description%"
        },
        "loginAPIPath": {
          "type": "string",
          "default": "/inter-api/auth/login",
          "description": "%config.loginAPIPath.description%"
        },
        "applicationMgrAPIPath": {
          "type": "string",
          "default": "/api/app/manager",
          "description": "%config.applicationMgrAPIPath.description%"
        },
        "uploadResourceAPIPath": {
          "type": "string",
          "default": "/api/app/manager/uploadResource",
          "description": "%config.uploadResourceAPIPath.description%"
        },
        "resourceAPIPath": {
          "type": "string",
          "default": "/resource",
          "description": "%config.resourceAPIPath.description%"
        },
        "programmableComponentMgrPath": {
          "type": "string",
          "default": "/extensions",
          "description": "%config.programmableComponentMgrPath.description%"
        },
        "componentSourceCodePath": {
          "type": "string",
          "default": "/source",
          "description": "%config.componentSourceCodePath.description%"
        },
        "componentCompiledCodePath": {
          "type": "string",
          "default": "/compiled",
          "description": "%config.componentCompiledCodePath.description%"
        },
        "componentCodeFileName": {
          "type": "string",
          "default": "index.js",
          "description": "%config.componentCodeFileName.description%"
        },
        "componentCodeLocalPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "%config.componentCodeLocalPath.description%"
        },
        "componentFolderAPIPath": {
          "type": "string",
          "default": "/api/app/resource/folder",
          "description": "%config.componentFolderAPIPath.description%"
        }
      }
    }
  },
  "scripts": {
    "vsce:package": "vsce-pnpm package --allow-missing-repository --no-rewrite-relative-links",
    "vsce:publish": "vsce-pnpm publish --allow-missing-repository --no-rewrite-relative-links",
    "vscode:prepublish": "pnpm package",
    "package": "pnpm gen && pnpm check-types && pnpm lint && node esbuild.js --production",
    "compile": "pnpm gen && pnpm check-types && pnpm lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "pnpm gen && node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm compile-tests && pnpm compile && pnpm lint",
    "check-types": "tsc --noEmit",
    "gen": "pnpm gen:snippets && pnpm gen:types",
    "gen:snippets": "node scripts/gen-snippets.mjs",
    "gen:types": "node scripts/gen-types.mjs",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.137.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vsce-pnpm": "^0.1.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@swc/wasm": "^1.16.21",
    "playwright-core": "^1.64.1"
  }
}